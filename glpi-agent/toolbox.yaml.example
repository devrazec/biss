---
# GLPI Agent - ToolBox plugin configuration
#
# Copy this file to glpi-agent/toolbox.yaml before `docker compose up`:
#     cp glpi-agent/toolbox.yaml.example glpi-agent/toolbox.yaml
#
# The running agent rewrites this same file when you add SNMP credentials,
# IP ranges or scan jobs through the web UI (http://localhost:62355/toolbox),
# so the real toolbox.yaml is git-ignored - it ends up holding secrets.
#
# Navigation bar pages (also togglable via the gear icon in the UI):
#   credentials_navbar - manage SNMP / SSH / WinRM credentials
#   iprange_navbar     - manage IP ranges (required for a Network scan job)
#   inventory_navbar   - create / run inventory task jobs
#   scheduling_navbar  - define schedules for those jobs
#   mibsupport_navbar  - tune SNMP results per device
#   results_navbar     - browse locally stored scan results
configuration:
  agent_home_navbar: yes
  credentials_navbar: yes
  inventory_navbar: yes
  iprange_navbar: yes
  scheduling_navbar: yes
  mibsupport_navbar: yes
  results_navbar: yes
  mibsupport_disabled: no
  yaml_navbar: no
  display_options: 30|0|5|10|20|40|50|100|500
  languages: en|fr
  session_timeout: '86400'
  updating_support: yes
