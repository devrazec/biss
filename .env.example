# Copy to .env and adjust as needed: cp .env.example .env

# Port on the host where GLPI's web UI is served
GLPI_HTTP_PORT=8080

# Database connection (used by both the glpi and db containers).
# When all five GLPI_DB_* values are set, GLPI auto-installs on first run
# and auto-updates its schema on restart.
GLPI_DB_HOST=db
GLPI_DB_PORT=3306
GLPI_DB_NAME=glpi
GLPI_DB_USER=glpi
GLPI_DB_PASSWORD=glpi

# Set to true to skip the automatic install / schema update
GLPI_SKIP_AUTOINSTALL=false
GLPI_SKIP_AUTOUPDATE=false

# Background cron worker (1 = enabled, 0 = disabled)
GLPI_CRONTAB_ENABLED=1

# Container timezone
TZ=UTC
