# Copy to .env and adjust as needed: cp .env.example .env

# Port on the host where GLPI's web UI is served
GLPI_HTTP_PORT=8080

# Database connection (used by both the glpi and db containers).
# When all five GLPI_DB_* values are set, GLPI auto-installs on first run
# and auto-updates its schema on restart.
GLPI_DB_HOST=db
GLPI_DB_PORT=3306
GLPI_DB_NAME=glpi
GLPI_DB_USER=glpi
GLPI_DB_PASSWORD=glpi

# MariaDB root password (used for admin tasks / manual DB creation)
DB_ROOT_PASSWORD=root

# Set to true to skip the automatic install / schema update
GLPI_SKIP_AUTOINSTALL=false
GLPI_SKIP_AUTOUPDATE=false

# Background cron worker (1 = enabled, 0 = disabled)
GLPI_CRONTAB_ENABLED=1

# Container timezone (also used as PHP_TZ for the Zabbix frontend)
TZ=UTC

# --- Zabbix -----------------------------------------------------------------
# Host port for the Zabbix web UI
ZBX_HTTP_PORT=8081
# Host port for the Zabbix server trapper (agents/proxies connect here)
ZBX_SERVER_PORT=10051
# Zabbix database on the shared MariaDB server. These values must match
# db-init/10-zabbix.sql, which creates the database and user on first boot.
ZBX_DB_NAME=zabbix
ZBX_DB_USER=zabbix
ZBX_DB_PASSWORD=zabbix
